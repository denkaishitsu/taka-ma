# G2 リレー設定（設計書 §8.17 第 1 段）
# 実値はこのファイルを relay.env にコピーして記入する。relay.env は配布物に含めない
# （ワークスペース固有 ID のため。トークン等の機密は含まない）。

# オーナーの Slack user_id。決着代行の decided_by に "g2:<この値>" で記録され、
# 監査ログ上で u-zu ボタン押下と区別できる（§8.17 決着の条件 6）。
OWNER_USER_ID=U00000000

# u-zu Bot との DM チャンネル ID（D...）。既定の会話面（上りの投稿先・下りの読取先）で、
# say.sh / decide.sh が channel_id を省略したときの既定値になる。
SLACK_DM_CHANNEL=D00000000

# Slack ワークスペースの team_id（T...）。会話レコードの conversation_id 導出に使用（§8.3）。
TEAM_ID=T00000000

# Slack トークンの取得元（macOS Keychain のサービス名）。トークン本体はここに書かない。
# 登録は構築手順書 09 Step 2-2（security add-generic-password）。
SLACK_TOKEN_KEYCHAIN_SERVICE=taka-ma-g2-relay
