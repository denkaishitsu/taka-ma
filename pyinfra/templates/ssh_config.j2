# Managed by pyinfra (taka-ma ssh_tunnel.py). Do not edit by hand.
# クラスタ相手機への SSH エイリアス（Tailscale 経由）。
# 既存 ~/.ssh/config を壊さないよう、本ファイルは ~/.ssh/config.d/ 配下に置き
# ~/.ssh/config から Include で取り込む。
# IdentityFile は自機専用鍵（マシン別鍵）。
Host {{ peer_alias }}
    HostName {{ peer_host }}
    User {{ peer_user }}
    IdentityFile {{ identity_file }}
    IdentitiesOnly yes
    StrictHostKeyChecking accept-new
    # 到達不能な相手へ無期限に張り付かない（ADR 0002・設計書 §8.5「SSH 呼び出しの上限」）。
    # 接続確立 10 秒、確立後の無応答は 15 秒 x 2 で切断、対話認証待ちは禁止。
    ConnectTimeout 10
    ServerAliveInterval 15
    ServerAliveCountMax 2
    BatchMode yes
